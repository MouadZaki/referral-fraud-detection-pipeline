# Stage 1 stack configuration — copy to ".env" in this same folder:
#     Copy-Item .env.example .env        (PowerShell)
#     cp .env.example .env               (bash)
#
# Non-secret values below are local development defaults.
#
# REQUIRED: the three *_PASSWORD entries are intentionally BLANK —
# you must choose your own local passwords before `docker compose up`.
# The stack will not run correctly without them (PostgreSQL refuses an
# empty POSTGRES_PASSWORD and Airflow needs an admin password).
# NEVER commit a real .env (it is git-ignored) and never put
# production secrets in this file.

# Airflow image: built locally by `docker compose build` from
# ./Dockerfile (apache/airflow:2.11.0-python3.11 + pinned DAG deps).
# Override only if you push the built image to a registry.
AIRFLOW_IMAGE_NAME=stage-1-airflow:2.11.0-py3.11

# UID for files written into ./logs by Airflow (Linux/WSL2).
# Harmless on Docker Desktop for Windows.
AIRFLOW_UID=50000

# --- Airflow metadata database (internal service, not our data) ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=            # REQUIRED: choose a local password
AIRFLOW_DB_NAME=airflow

# --- Airflow UI admin user created by airflow-init (dev only) ---
# Login at http://localhost:8080
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=     # REQUIRED: choose a local password

# --- Target PostgreSQL: the database the Story 3 DAG loads into ---
# These feed both the postgres-target service and the pre-created
# Airflow connection `target_postgres`. Host/port are the in-network
# values; from your Windows host use localhost:5433 instead.
TARGET_POSTGRES_HOST=postgres-target
TARGET_POSTGRES_PORT=5432
TARGET_POSTGRES_USER=etl_user
TARGET_POSTGRES_PASSWORD=       # REQUIRED: choose a local password
TARGET_POSTGRES_DB=conversations_db
