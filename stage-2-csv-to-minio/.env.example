# Stage 2 environment template — copy to `.env` before `docker compose up`.
# `.env` is git-ignored; NEVER commit real passwords.
#
# REQUIRED: the three blank *_PASSWORD entries must be filled with your
# own local passwords; Compose rejects an empty value.

# --- Airflow image (built from ./Dockerfile) ---
AIRFLOW_IMAGE_NAME=stage-2-airflow:2.11.0-py3.11
AIRFLOW_UID=50000                 # harmless on Docker Desktop/Windows
AIRFLOW_WEB_PORT=8081             # Stage 1 stack occupies host :8080

# --- Airflow metadata database (internal, not our data) ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=              # REQUIRED: choose a local password
AIRFLOW_DB_NAME=airflow

# --- Airflow UI admin ---
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=       # REQUIRED: choose a local password

# --- MinIO object store ---
# Chainguard minimal MinIO image, pinned by digest (this digest was
# pull-verified). Bump by pulling a newer image and pasting its digest.
MINIO_IMAGE_NAME=cgr.dev/chainguard/minio@sha256:3c60a2a8c4d33409a9bc7a623a7fcbfb4605adc3d89422d2f53b3f673a6e5597
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=              # REQUIRED: MinIO needs >= 8 chars
MINIO_BUCKET=stage2-data          # Parquet landing bucket for the DAG
